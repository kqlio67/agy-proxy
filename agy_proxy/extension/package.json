{
  "name": "agy-proxy-companion",
  "displayName": "Antigravity Proxy Hub & Quota Monitor",
  "description": "Real-time quota monitoring, Brain cache cleaning, auto-failover toggle, and account switching for Google Antigravity.",
  "version": "1.0.0",
  "publisher": "kqlio67",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agy-proxy.showDashboard",
        "title": "Antigravity Proxy: Open Web Dashboard",
        "category": "AGY Proxy"
      },
      {
        "command": "agy-proxy.cleanCache",
        "title": "Antigravity Proxy: Clean Brain & IDE Cache",
        "category": "AGY Proxy"
      },
      {
        "command": "agy-proxy.switchAccount",
        "title": "Antigravity Proxy: Switch Active Pool Account",
        "category": "AGY Proxy"
      },
      {
        "command": "agy-proxy.toggleFailover",
        "title": "Antigravity Proxy: Toggle 429 Auto-Failover",
        "category": "AGY Proxy"
      },
      {
        "command": "agy-proxy.refreshQuota",
        "title": "Antigravity Proxy: Refresh Quotas Now",
        "category": "AGY Proxy"
      }
    ],
    "configuration": {
      "title": "Antigravity Proxy",
      "properties": {
        "agyProxy.url": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "URL of the local agy-proxy hub instance"
        },
        "agyProxy.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "description": "Interval in seconds to poll quota and proxy health"
        }
      }
    }
  }
}
